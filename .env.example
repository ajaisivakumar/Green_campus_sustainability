# Green Campus Sustainability Auditor — Environment Configuration
# Copy this file to .env and adjust values. Never commit .env to version control.

# Application
APP_NAME="Green Campus Sustainability Auditor"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# ── Database ────────────────────────────────────────────────────────────────
# Option A: Neon PostgreSQL (recommended for production)
#   Get your connection string from https://console.neon.tech
#   Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Local SQLite (development/fallback)
# DATABASE_URL=sqlite:///./green_campus.db

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# ── File uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads

# ── Emission factors ─────────────────────────────────────────────────────────
# Default: India CEA grid emission factor 2022-23 (0.716 kgCO2e/kWh)
# Source: CEA CO2 Baseline Database for the Indian Power Sector, Version 18
DEFAULT_EMISSION_FACTOR=0.716
EMISSION_FACTOR_SOURCE="CEA CO2 Baseline Database Version 18 (2022-23)"
EMISSION_FACTOR_UNIT="kgCO2e/kWh"

# ── Google Gemini Free API ────────────────────────────────────────────────────
# Get your free API key at https://aistudio.google.com/app/apikey
# Free tier model options: gemini-1.5-flash (recommended), gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true

# ── Demo data ────────────────────────────────────────────────────────────────
DEMO_SEED=42
DEMO_CAMPUS_NAME="Green Valley University (Demo)"
